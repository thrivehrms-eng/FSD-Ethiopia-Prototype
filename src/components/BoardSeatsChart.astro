---
import SourceLink from './SourceLink.astro';
import figures from '../data/figures.json';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const banks = figures.womenBankBoardSeats;
const ecma = figures.ecmaIssuerBoardMinimum;
const rows = [
  { label: t(lang, 'home.boards.chartBanks'), value: banks.value },
  { label: t(lang, 'home.boards.chartEcma'), value: ecma.value },
];
const summary = rows.map((r) => `${r.label}: ${r.value}%`).join('. ');
---

<figure class="border-t-4 border-teal-700 pt-5" lang="en">
  <figcaption class="font-display text-[1.5rem] font-semibold text-teal-700">{t(lang, 'home.boards.chartTitle')}</figcaption>
  <div class="relative mt-4 h-56 sm:h-48">
    <canvas
      data-board-chart
      data-rows={JSON.stringify(rows)}
      data-axis={t(lang, 'home.boards.chartAxis')}
      class="max-w-full"
      role="img"
      aria-label={`${t(lang, 'home.boards.chartTitle')}. ${summary}.`}
      width="640"
      height="220"
    >
      {summary}
    </canvas>
  </div>
  <details class="mt-4">
    <summary class="cursor-pointer font-medium text-green-600">{t(lang, 'common.viewTable')}</summary>
    <table class="mt-3 w-full text-left text-[0.9375rem]">
      <caption class="sr-only">{t(lang, 'home.boards.tableCaption')}</caption>
      <thead>
        <tr class="border-b-2 border-teal-700">
          <th scope="col" class="py-2 pr-4">{t(lang, 'home.boards.colMeasure')}</th>
          <th scope="col" class="py-2 text-right">{t(lang, 'home.boards.colShare')}</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((r) => (
            <tr class="border-b border-line">
              <th scope="row" class="py-2 pr-4 font-normal">{r.label}</th>
              <td class="py-2 text-right tabular-nums">{r.value}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </details>
  <div class="mt-4 space-y-1">
    <SourceLink lang={lang} title={banks.sourceTitle} url={banks.sourceUrl} />
    <SourceLink lang={lang} title={ecma.sourceTitle} url={ecma.sourceUrl} />
  </div>
</figure>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-board-chart]');

  async function draw(el: HTMLCanvasElement) {
    const { Chart, BarController, BarElement, CategoryScale, LinearScale } = await import('chart.js');
    Chart.register(BarController, BarElement, CategoryScale, LinearScale);
    const rows: { label: string; value: number }[] = JSON.parse(el.dataset.rows!);
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ink = '#1C2B2D';
    // Split long category labels over several lines so they are never clipped.
    const wrap = (text: string, max: number) =>
      text.split(' ').reduce<string[]>((lines, word) => {
        const last = lines[lines.length - 1];
        if (last && `${last} ${word}`.length <= max) lines[lines.length - 1] = `${last} ${word}`;
        else lines.push(word);
        return lines;
      }, []);

    // Values are printed at the end of each bar so colour is never the only cue.
    const valueLabels = {
      id: 'valueLabels',
      afterDatasetsDraw(chart: InstanceType<typeof Chart>) {
        const { ctx } = chart;
        chart.getDatasetMeta(0).data.forEach((bar, i) => {
          ctx.save();
          ctx.fillStyle = ink;
          ctx.font = '600 15px Poppins, sans-serif';
          ctx.textBaseline = 'middle';
          ctx.fillText(`${rows[i].value}%`, bar.x + 8, bar.y);
          ctx.restore();
        });
      },
    };

    new Chart(el, {
      type: 'bar',
      data: {
        labels: rows.map((r) => wrap(r.label, el.clientWidth < 480 ? 16 : 26)),
        datasets: [
          {
            data: rows.map((r) => r.value),
            backgroundColor: ['#276C4B', '#0F3639'],
            borderRadius: 1,
            barThickness: 34,
          },
        ],
      },
      options: {
        indexAxis: 'y',
        responsive: true,
        maintainAspectRatio: false,
        animation: reduce ? false : { duration: 500 },
        events: [],
        layout: { padding: { right: 48 } },
        plugins: { legend: { display: false }, tooltip: { enabled: false } },
        scales: {
          x: {
            min: 0,
            max: 50,
            title: { display: true, text: el.dataset.axis, color: ink, font: { family: 'Poppins', size: 13 } },
            ticks: { color: ink, font: { family: 'Poppins', size: 13 }, callback: (v) => `${v}%` },
            grid: { color: '#C9D6D2' },
          },
          y: {
            ticks: { color: ink, font: { family: 'Poppins', size: 13 } },
            grid: { display: false },
          },
        },
      },
      plugins: [valueLabels],
    });
  }

  if (canvas) {
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          draw(canvas);
        }
      },
      { rootMargin: '200px' },
    );
    io.observe(canvas);
  }
</script>
