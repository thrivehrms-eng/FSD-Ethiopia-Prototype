---
// Horizontal bar chart (Chart.js, loaded when it scrolls into view) with value
// labels on the bars, a text summary for screen readers and a data table.
// Category names sit on the axis, so colour never carries meaning alone.
import { t, type Lang } from '../../i18n';

interface Row {
  label: string;
  value: number;
  colour: string;
}

interface Props {
  lang: Lang;
  id: string;
  title: string;
  axis: string;
  tableCaption: string;
  colLabel: string;
  colValue: string;
  rows: Row[];
  max?: number;
  unit?: string;
}

const { lang, id, title, axis, tableCaption, colLabel, colValue, rows, max = 100, unit = '%' } = Astro.props;
const summary = rows.map((r) => `${r.label}: ${r.value}${unit}`).join('. ');
---

<figure class="hbar" lang="en">
  <figcaption class="t-label text-[0.8125rem] text-teal-700">{title}</figcaption>
  <div class="relative mt-4 h-52">
    <canvas
      id={id}
      data-hbar
      data-rows={JSON.stringify(rows)}
      data-axis={axis}
      data-max={max}
      data-unit={unit}
      role="img"
      aria-label={`${title}. ${summary}.`}
      width="560"
      height="208"
      class="max-w-full"
    >
      {summary}
    </canvas>
  </div>
  <details class="mt-4">
    <summary class="cursor-pointer text-[0.875rem] font-semibold text-green-600">{t(lang, 'common.viewTable')}</summary>
    <table class="mt-3 w-full text-left text-[0.875rem]">
      <caption class="sr-only">{tableCaption}</caption>
      <thead>
        <tr class="border-b-2 border-teal-700">
          <th scope="col" class="py-2 pr-4">{colLabel}</th>
          <th scope="col" class="py-2 text-right">{colValue}</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((r) => (
            <tr class="border-b border-line">
              <th scope="row" class="py-2 pr-4 font-normal">{r.label}</th>
              <td class="py-2 text-right tabular-nums">{r.value}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </details>
</figure>

<script>
  async function draw(el: HTMLCanvasElement) {
    const { Chart, BarController, BarElement, CategoryScale, LinearScale } = await import('chart.js');
    Chart.register(BarController, BarElement, CategoryScale, LinearScale);
    const rows: { label: string; value: number; colour: string }[] = JSON.parse(el.dataset.rows!);
    const unit = el.dataset.unit ?? '';
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ink = '#141516';
    const font = { family: 'Poppins', size: 13 };
    const valueLabels = {
      id: 'valueLabels',
      afterDatasetsDraw(chart: InstanceType<typeof Chart>) {
        const { ctx } = chart;
        chart.getDatasetMeta(0).data.forEach((bar, i) => {
          ctx.save();
          ctx.fillStyle = ink;
          ctx.font = '600 15px Poppins, sans-serif';
          ctx.textBaseline = 'middle';
          ctx.fillText(`${rows[i].value}${unit}`, bar.x + 8, bar.y);
          ctx.restore();
        });
      },
    };
    new Chart(el, {
      type: 'bar',
      data: {
        labels: rows.map((r) => r.label),
        datasets: [{ data: rows.map((r) => r.value), backgroundColor: rows.map((r) => r.colour), borderRadius: 2, barThickness: 30 }],
      },
      options: {
        indexAxis: 'y',
        responsive: true,
        maintainAspectRatio: false,
        animation: reduce ? false : { duration: 500 },
        events: [],
        layout: { padding: { right: 52 } },
        plugins: { legend: { display: false }, tooltip: { enabled: false } },
        scales: {
          x: {
            min: 0,
            max: Number(el.dataset.max),
            title: { display: true, text: el.dataset.axis, color: ink, font },
            ticks: { color: ink, font, callback: (v) => `${v}${unit}` },
            grid: { color: '#C9D6D2' },
          },
          y: { ticks: { color: ink, font }, grid: { display: false } },
        },
      },
      plugins: [valueLabels],
    });
  }

  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          io.unobserve(entry.target);
          draw(entry.target as HTMLCanvasElement);
        }
      }
    },
    { rootMargin: '200px' },
  );
  document.querySelectorAll<HTMLCanvasElement>('[data-hbar]').forEach((el) => io.observe(el));
</script>
