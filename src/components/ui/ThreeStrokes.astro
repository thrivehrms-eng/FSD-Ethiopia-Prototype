---
// The three strokes from FSD Ethiopia's logo (assets-src/brand/fsd-logo-colour.svg),
// without the wordmark. Decorative only.
interface Props {
  tone?: 'brand' | 'yellow' | 'white';
  class?: string;
  /** Adds a non-scaling outline so the strokes keep a visible weight when scaled. */
  weight?: number;
  preserveAspectRatio?: string;
  style?: string;
  /** "line": centre lines traced from the logo paths, at a constant stroke width (map frame). */
  variant?: 'shape' | 'line';
  lineWidth?: number;
}

const { tone = 'brand', class: className, weight = 0, preserveAspectRatio = 'xMidYMid meet', style, variant = 'shape', lineWidth = 4 } = Astro.props;
// Centre lines of the three logo strokes, in the same coordinates as the shapes below.
const lines = [
  'M279.94 408.79 L269.47 422.79 L282.9 434.73',
  'M287.07 400.64 L301.3 406.6 L300.45 413.9 L304.63 412.89',
  'M307.45 419.66 L324.2 422.4 L313.3 431.5 L297.43 438.61',
];
const colours =
  tone === 'brand' ? ['#F7DE4D', '#3E8740', '#C93129'] : tone === 'yellow' ? ['#F7DE4D', '#F7DE4D', '#F7DE4D'] : ['#fff', '#fff', '#fff'];
const outline = weight ? { stroke: 'currentColor', 'stroke-width': weight, 'vector-effect': 'non-scaling-stroke', 'stroke-linejoin': 'round' } : {};
---

<svg
  class={className}
  style={style}
  viewBox="268.9 400.2 56.4 38.9"
  preserveAspectRatio={preserveAspectRatio}
  aria-hidden="true"
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
>
  {
    variant === 'line'
      ? lines.map((d, i) => (
          <path d={d} fill="none" stroke={colours[i]} stroke-width={lineWidth} vector-effect="non-scaling-stroke" stroke-linecap="round" stroke-linejoin="miter" />
        ))
      : (
          <Fragment>
  <path
    fill={colours[0]}
