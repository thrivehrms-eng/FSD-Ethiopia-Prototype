  ></path>
  <path
    fill={colours[1]}
    style={`color:${colours[1]}`}
    {...outline}
    d="M 304.632812 412.894531 C 303.742188 413.21875 302.832031 413.496094 301.921875 413.773438 C 301.449219 413.910156 301.039062 414.046875 300.484375 414.109375 C 300.464844 414.113281 300.417969 414.109375 300.386719 414.105469 C 300.386719 414.105469 300.324219 414.101562 300.246094 414.042969 C 300.1875 413.992188 300.136719 413.933594 300.152344 413.785156 C 300.199219 413.628906 300.214844 413.652344 300.199219 413.652344 L 300.195312 413.648438 L 300.191406 413.640625 L 300.207031 413.515625 L 300.246094 413.179688 L 300.300781 412.476562 L 300.660156 406.8125 L 300.917969 407.242188 C 298.554688 406.265625 296.257812 405.144531 293.925781 404.097656 C 291.625 402.980469 289.320312 401.875 287.070312 400.644531 C 289.496094 401.480469 291.867188 402.4375 294.238281 403.390625 C 296.578125 404.410156 298.957031 405.355469 301.265625 406.449219 L 301.550781 406.582031 L 301.523438 406.875 C 301.355469 408.765625 301.210938 410.65625 300.925781 412.542969 L 300.8125 413.253906 L 300.742188 413.617188 C 300.726562 413.691406 300.734375 413.710938 300.683594 413.835938 L 300.652344 413.917969 L 300.632812 413.953125 C 300.617188 413.96875 300.628906 414.007812 300.671875 413.863281 C 300.671875 413.734375 300.628906 413.683594 300.585938 413.640625 C 300.523438 413.589844 300.46875 413.589844 300.492188 413.59375 C 300.492188 413.59375 300.46875 413.59375 300.484375 413.59375 C 300.871094 413.574219 301.382812 413.464844 301.835938 413.398438 Z"
  ></path>
  <path
