---
// Site search (Fuse.js). The index is a static JSON file built from src/data, and
// both are loaded only when the dialog first opens.
import { X, Search } from '@lucide/astro';
import { t, langOf, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const labels = JSON.stringify({
  loading: t(lang, 'search.loading'),
  empty: t(lang, 'search.empty'),
  noResults: t(lang, 'search.noResults'),
  count: t(lang, 'search.count'),
  types: {
    page: t(lang, 'search.types.page'),
    news: t(lang, 'search.types.news'),
    publication: t(lang, 'search.types.publication'),
  },
});
---

<div x-data="modal">
  <dialog
    id="site-search"
    x-ref="dialog"
    x-on:open-request="open($event.detail); $dispatch('dialog-opened')"
    x-on:close="restoreFocus()"
    aria-labelledby="site-search-title"
    class="m-auto mt-[10vh] w-[min(44rem,calc(100%-2rem))] rounded-sm bg-white p-0 text-ink backdrop:bg-teal-950/70"
  >
    <div class="p-5 sm:p-8" x-data="siteSearch" data-labels={labels} x-init="$el.closest('dialog').addEventListener('dialog-opened', () => { load(); $refs.q.focus() })">
      <div class="flex items-start justify-between gap-4">
        <h2 id="site-search-title" class="t-section text-[1.875rem]" lang={langOf(lang, 'search.title')}>{t(lang, 'search.title')}</h2>
        <button type="button" x-on:click="close()" class="flex size-11 shrink-0 cursor-pointer items-center justify-center rounded-full hover:bg-mist" aria-label={t(lang, 'search.close')}>
          <X size={22} aria-hidden="true" />
        </button>
      </div>
      <form role="search" class="mt-5" x-on:submit.prevent="search()">
        <label for="site-search-q" class="t-label block text-green-600" lang={langOf(lang, 'search.label')}>{t(lang, 'search.label')}</label>
        <div class="relative mt-2">
          <Search size={20} class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-slate" aria-hidden="true" />
          <input
            id="site-search-q"
            x-ref="q"
            type="search"
            autocomplete="off"
            class="field-input pl-10"
            x-model="query"
            x-on:input.debounce.150ms="search()"
            aria-describedby="site-search-status"
          />
        </div>
      </form>
      <p id="site-search-status" class="mt-3 t-meta" role="status" aria-live="polite" lang="en" x-text="status()">{t(lang, 'search.loading')}</p>
      <ul class="mt-4 divide-y divide-line" lang="en">
        <template x-for="r in results" x-bind:key="r.url">
          <li class="py-3">
            <a x-bind:href="r.url" class="group block no-underline">
              <span class="t-label block text-[0.75rem] text-slate" x-text="labels.types[r.type]"></span>
              <span class="mt-0.5 block font-semibold text-green-600 group-hover:underline" x-text="r.title"></span>
              <span class="mt-0.5 block text-[0.875rem] text-ink" x-text="r.summary"></span>
            </a>
          </li>
        </template>
      </ul>
    </div>
  </dialog>
</div>
