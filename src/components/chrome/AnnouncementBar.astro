---
// 4.0 Announcement bar: the next open opportunity, or a general pointer when none
// is open. Visitors can dismiss it; the choice is remembered per opportunity.
import { X } from '@lucide/astro';
import { nextOpen, formatDate } from '../../lib/opportunities';
import { t, langOf, localePath, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const id = nextOpen?.id ?? 'general';
const text = nextOpen
  ? t(lang, 'announce.nowOpen', { title: nextOpen.shortTitle, date: formatDate(nextOpen.deadline) })
  : t(lang, 'announce.fallback');
const textLang = nextOpen ? 'en' : langOf(lang, 'announce.fallback');
---

<aside x-data={`announcement('${id}')`} x-show="visible" aria-label={t(lang, 'announce.label')} class="on-dark relative z-50 bg-green-600 text-white">
  <div class="container-site flex min-h-10 items-center justify-center gap-3 py-1.5 pr-12 text-center text-[0.875rem] leading-snug sm:pr-14">
    <a href={localePath(lang, '/opportunities/')} class="text-white underline-offset-4 hover:text-yellow-400" lang={textLang}>{text}</a>
  </div>
  <button
    type="button"
    x-on:click="dismiss()"
    class="absolute right-1 top-1/2 flex size-10 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full text-white hover:bg-white/15 sm:right-3"
    aria-label={t(lang, 'announce.dismiss')}
  >
    <X size={18} aria-hidden="true" />
  </button>
</aside>
