---
// 4.0 Announcement bar: the next open opportunity, or a general pointer when none
// is open. Open or closed is re-checked in the browser, so a call that closes after
// the build is never advertised. Visitors can dismiss it (remembered per opportunity).
import { X } from '@lucide/astro';
import { nextOpen, formatDate, closesAtIso, opportunities, type Opportunity } from '../../lib/opportunities';
import { t, langOf, localePath, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const all = [...opportunities.procurement, ...opportunities.careers] as Opportunity[];
const listings = all.map((o) => ({
  id: o.id,
  text: t(lang, 'announce.nowOpen', { title: o.shortTitle, date: formatDate(o.deadline) }),
  closesAt: closesAtIso(o),
}));
const fallback = t(lang, 'announce.fallback');
const fallbackLang = langOf(lang, 'announce.fallback');
// No-JS default: the state at build time.
const text = nextOpen ? t(lang, 'announce.nowOpen', { title: nextOpen.shortTitle, date: formatDate(nextOpen.deadline) }) : fallback;
const textLang = nextOpen ? 'en' : fallbackLang;
---

<aside
  x-data="announcement"
  x-show="visible"
  aria-label={t(lang, 'announce.label')}
  data-listings={JSON.stringify(listings)}
  data-fallback={fallback}
  data-fallback-lang={fallbackLang}
  class="on-dark relative z-50 bg-green-600 text-white"
>
  <div class="container-site flex min-h-10 items-center justify-center py-2 pr-12 text-center text-[0.875rem] leading-snug sm:pr-14">
    <a
      href={localePath(lang, '/opportunities/')}
      class="block min-w-0 truncate text-white underline-offset-4 hover:text-yellow-400 sm:whitespace-normal"
      lang={textLang}
      x-bind:lang="textLang"
      x-text="text">{text}</a
    >
  </div>
  <button
    type="button"
    x-on:click="dismiss()"
    class="absolute right-1 top-1/2 flex size-10 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full text-white hover:bg-white/15 sm:right-3"
    aria-label={t(lang, 'announce.dismiss')}
  >
    <X size={18} aria-hidden="true" />
  </button>
</aside>
