---
// 4.14 Closing band: the skyline duotoned teal to green, a huge three-stroke
// watermark, the centred reversed logo, FSD's own tagline and two actions.
// It flows into the footer in the same teal-900.
import Duotone from '../ui/Duotone.astro';
import ThreeStrokes from '../ui/ThreeStrokes.astro';
import { t, langOf, localePath, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="on-dark relative isolate overflow-hidden bg-teal-900 text-white" aria-labelledby="closing-tagline">
  <Duotone id="skyline-panorama" sizes="100vw" maxWidth={1900} strength={0.45} class="-z-10" />
  <div class="absolute inset-x-0 bottom-0 -z-10 h-1/2 bg-gradient-to-b from-transparent to-teal-900" aria-hidden="true"></div>
  <ThreeStrokes tone="yellow" class="pointer-events-none absolute left-1/2 top-1/2 -z-10 w-[min(1100px,140vw)] -translate-x-1/2 -translate-y-1/2 opacity-[0.08]" />
  <div class="container-site flex min-h-[26rem] flex-col items-center justify-center py-16 text-center lg:min-h-[26.25rem]">
    <img src="/brand/fsd-logo-reversed.svg" alt="" width="170" height="120" loading="lazy" class="h-24 w-auto sm:h-30" />
    <p id="closing-tagline" class="t-hero mt-6 max-w-4xl text-[clamp(1.875rem,4vw,3.25rem)] leading-none" lang={langOf(lang, 'closing.tagline')}>
      {t(lang, 'closing.tagline')}
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <button type="button" data-open-dialog="newsletter-dialog" class="btn btn-on-dark" aria-haspopup="dialog" lang={langOf(lang, 'closing.subscribe')}>
        {t(lang, 'closing.subscribe')}
      </button>
      <a href={localePath(lang, '/contact/')} class="btn btn-outline-on-dark" lang={langOf(lang, 'closing.contact')}>{t(lang, 'closing.contact')}</a>
    </div>
  </div>
</section>
