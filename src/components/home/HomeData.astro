---
// 4.8 Data snapshot: two KPI tiles from figures.json with visible sources, a chart of
// account ownership by gender, and two climate finance charts from FSD's 2026
// landscape report: a donut of finance by use and bars of yearly flows against the
// annual need (one shared axis). The only section that shows sources on the page.
import SectionTitle from '../ui/SectionTitle.astro';
import ArrowLink from '../ui/ArrowLink.astro';
import HBarChart from '../ui/HBarChart.astro';
import DonutChart from '../ui/DonutChart.astro';
import ComboChart from '../ui/ComboChart.astro';
import { SERIES } from '../../scripts/chart-theme';
import figures from '../../data/figures.json';
import { t, langOf, localePath, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const mm = figures.mobileMoneyAccounts2025;
const women = figures.accountOwnershipWomen2024;
const men = figures.accountOwnershipMen2024;
const all = figures.accountOwnershipAll2024;
const flows = figures.climateFinanceFlows;
const need = figures.climateFinanceNeed;
const byUse = figures.climateFinanceByUse2022_23;
const k = (key: string, vars?: Record<string, string | number>) => t(lang, `home.data.${key}`, vars);
const usd = (m: number) => (m >= 1000 ? `USD ${m / 1000} bn` : `USD ${m} m`);
const useName = { adaptation: 'useAdaptation', mitigation: 'useMitigation', dual: 'useDual' } as const;
const useColour = { adaptation: SERIES.green, mitigation: SERIES.blue, dual: SERIES.gold } as const;
const tile = 'flex flex-col bg-white p-6 sm:p-7';
---

<section id="data-snapshot" class="section bg-mist" aria-labelledby="data-title">
  <div class="container-site">
    <SectionTitle lang={lang} k="home.data.title" id="data-title" />
    <div class="mt-10 grid gap-6 lg:grid-cols-12 lg:gap-8">
      <div class="grid gap-6 sm:grid-cols-2 lg:col-span-6 lg:grid-cols-1" lang="en">
        <article class={tile} data-reveal>
          <h3 class="t-label text-[0.8125rem] text-slate">{k('mobileMoney')}</h3>
          <p class="t-stat mt-3">{mm.display}</p>
          <p class="mt-2 text-[0.9375rem]">{k('mobileMoneyNote')}</p>
          <p class="source-link mt-auto pt-4 text-slate">{t(lang, 'common.source')}: <a href={mm.sourceUrl}>{mm.sourceTitle}</a></p>
        </article>
        <article class={tile} data-reveal>
          <h3 class="t-label text-[0.8125rem] text-slate">{k('ownership')}</h3>
          <p class="mt-3 flex flex-wrap items-baseline gap-x-6 gap-y-1">
            <span><span class="t-stat">{women.value}%</span> <span class="t-label text-[0.8125rem] text-slate">{k('ownershipWomen')}</span></span>
            <span><span class="t-stat text-teal-900">{men.value}%</span> <span class="t-label text-[0.8125rem] text-slate">{k('ownershipMen')}</span></span>
          </p>
          <p class="mt-2 text-[0.9375rem]">{k('ownershipNote')}</p>
          <p class="source-link mt-auto pt-4 text-slate">{t(lang, 'common.source')}: <a href={women.sourceUrl}>{women.sourceTitle}</a></p>
        </article>
      </div>
      <div class="bg-white p-6 sm:p-7 lg:col-span-6" data-reveal>
        <HBarChart
          lang={lang}
          id="ownership-chart"
          title={k('chartTitle')}
          axis={k('chartAxis')}
          tableCaption={k('tableCaption')}
          colLabel={k('colGroup')}
          colValue={k('colShare')}
          rows={[
            { label: k('chartWomen'), value: women.value, colour: '#276C4B' },
            { label: k('chartMen'), value: men.value, colour: '#0F3639' },
            { label: k('chartAll'), value: all.value, colour: '#4A5560' },
          ]}
        />
        <p class="source-link mt-4 text-slate" lang="en">
          {t(lang, 'common.sources')}: <a href={women.sourceUrl}>{women.sourceTitle}</a>; <a href={all.sourceUrl}>{all.sourceTitle}</a>
        </p>
      </div>
      <div class="flex flex-col bg-white p-6 sm:p-7 lg:col-span-5" data-reveal lang="en">
        <DonutChart
          lang={lang}
          id="climate-use-chart"
          title={k('donutTitle')}
          centre={k('donutCentre', { value: byUse.total.value })}
          centreSub={k('donutCentreSub')}
          tableCaption={k('donutTableCaption')}
          colLabel={k('colUse')}
          colShare={k('colShare')}
          colAmount={k('colAmount')}
          parts={byUse.parts.map((p) => ({ label: k(useName[p.key as keyof typeof useName]), share: p.share, amount: usd(p.usdMillion), colour: useColour[p.key as keyof typeof useColour] }))}
        />
        <p class="mt-4 text-[0.9375rem]">{k('donutNote')}</p>
        <p class="source-link mt-auto pt-4 text-slate">{t(lang, 'common.source')}: <a href={byUse.sourceUrl}>{byUse.sourceTitle}</a></p>
      </div>
      <div class="flex flex-col bg-white p-6 sm:p-7 lg:col-span-7" data-reveal lang="en">
        <ComboChart
          lang={lang}
          id="climate-flows-chart"
          title={k('comboTitle')}
          axis={k('comboAxis')}
          barLabel={k('comboBars')}
          lineLabel={k('comboLine')}
          lineValue={need.value}
          lineTag={k('comboLineTag', { value: need.value })}
          tableCaption={k('comboTableCaption')}
          colLabel={k('colYear')}
          colValue={k('colUsdBn')}
          points={flows.series.map((p) => ({ label: String(p.year), value: p.value }))}
          max={12}
          barColour={SERIES.green}
          lineColour={SERIES.blue}
          valueFormat="USD {v} bn"
        />
        <p class="mt-4 text-[0.9375rem]">{k('comboNote')}</p>
        <p class="source-link mt-auto pt-4 text-slate">{t(lang, 'common.source')}: <a href={flows.sourceUrl}>{flows.sourceTitle}</a></p>
      </div>
    </div>
    <ArrowLink href={localePath(lang, '/data/')} class="mt-8" lang={langOf(lang, 'home.data.link')}>{k('link')}</ArrowLink>
  </div>
</section>
