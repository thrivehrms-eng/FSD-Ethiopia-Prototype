---
// 4.10 The people behind the work: six staff portraits, names and roles exactly as
// on the team page (CLAUDE.md 6.2).
import SectionTitle from '../ui/SectionTitle.astro';
import ArrowLink from '../ui/ArrowLink.astro';
import PortraitCard from '../ui/PortraitCard.astro';
import { getImage } from '../../lib/images';
import { t, langOf, localePath, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ids = ['hikmet-abdella', 'abel-tadelle', 'gosaye-warsa', 'selamsew-tesfaye', 'sinidu-fikadu', 'bezawit-eshetu'];
const people = ids.map((id) => {
  const image = getImage(`staff-${id}`);
  return { id, image: `staff-${id}`, name: image.person!.name!, role: image.person!.role };
});
---

<section class="section bg-white" aria-labelledby="people-title">
  <div class="container-site">
    <SectionTitle lang={lang} k="home.people.title" id="people-title">
      <ArrowLink href={localePath(lang, '/about/team/')} class="hidden sm:inline-flex" lang={langOf(lang, 'home.people.link')}>{t(lang, 'home.people.link')}</ArrowLink>
    </SectionTitle>
  </div>
  <ul class="snap-row mt-10 px-4 sm:px-6 lg:mx-auto lg:grid lg:max-w-[80rem] lg:grid-cols-6 lg:gap-6 lg:overflow-visible" role="list">
    {
      people.map((p) => (
        <li class="w-[44vw] max-w-56 lg:w-auto lg:max-w-none" data-reveal>
          <PortraitCard
            id={p.image}
            name={p.name}
            role={p.role}
            href={localePath(lang, `/about/team/#${p.id}`)}
            sizes="(min-width: 1024px) 190px, 44vw"
            maxWidth={224}
          />
        </li>
      ))
    }
  </ul>
  <div class="container-site mt-8 sm:hidden">
    <ArrowLink href={localePath(lang, '/about/team/')} lang={langOf(lang, 'home.people.link')}>{t(lang, 'home.people.link')}</ArrowLink>
  </div>
</section>
