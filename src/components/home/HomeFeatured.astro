---
// 4.6 Featured work: a manual slider of five items (nothing moves on its own).
// Large image left (640px at most), text right, a second image staggered below.
import SectionTitle from '../ui/SectionTitle.astro';
import ArrowButton from '../ui/ArrowButton.astro';
import ArrowLink from '../ui/ArrowLink.astro';
import Img from '../ui/Img.astro';
import GradientPanel from '../ui/GradientPanel.astro';
import Credit from '../ui/Credit.astro';
import featured from '../../data/featured.json';
import { formatDate, formatMonth } from '../../lib/opportunities';
import { t, langOf, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const total = featured.length;
---

<section
  id="featured"
  class="section bg-mist"
  aria-labelledby="featured-title"
  x-data="slider('single')"
  x-on:keydown="onKey($event)"
>
  <div class="container-site">
    <SectionTitle lang={lang} k="home.featured.title" id="featured-title">
      <ArrowButton dir="prev" label={t(lang, 'slider.prev')} aria-controls="featured-slides" x-on:click="prev()" x-bind:aria-disabled="atStart.toString()" aria-disabled="true" />
      <ArrowButton dir="next" label={t(lang, 'slider.next')} aria-controls="featured-slides" x-on:click="next()" x-bind:aria-disabled="atEnd.toString()" aria-disabled="false" />
    </SectionTitle>

    <div
      id="featured-slides"
      data-slides
      tabindex="-1"
      class="mt-10 outline-none"
      role="region"
      aria-roledescription={t(lang, 'slider.carousel')}
      aria-label={t(lang, 'home.featured.region')}
      aria-live="polite"
    >
      {
        featured.map((item, i) => (
          <div
            data-slide
            role="group"
            aria-roledescription={t(lang, 'slider.slide')}
            aria-label={t(lang, 'slider.slideOf', { n: i + 1, total })}
            hidden={i !== 0}
            x-bind:hidden={`index !== ${i}`}
            class="grid gap-8 lg:grid-cols-12 lg:gap-12"
          >
            <figure class="lg:col-span-7">
              <div class="zoom-host aspect-[16/10] max-w-[640px] overflow-hidden">
                <Img id={item.image} sizes="(min-width: 640px) 640px, 92vw" maxWidth={640} aspect={1.6} class="h-full w-full" />
              </div>
              <figcaption class="mt-2 text-slate">
                <Credit id={item.image} />
              </figcaption>
            </figure>
            <div class="flex flex-col lg:col-span-5">
              <p class="t-label text-[0.75rem] text-slate">{t(lang, 'slider.slideOf', { n: i + 1, total })}</p>
              <h3 class="t-card mt-3 text-[1.25rem]" lang="en">{item.title}</h3>
              <p class="t-meta mt-2" lang="en">
                <time datetime={item.date}>{item.datePrecision === 'month' ? formatMonth(item.date) : formatDate(item.date)}</time>
                <span aria-hidden="true"> · </span>
                <span>{item.place}</span>
              </p>
              <p class="mt-4" lang="en">{item.summary}</p>
              <ArrowLink href={item.url} context={item.title} class="mt-5 self-start" lang={langOf(lang, 'common.readMore')}>
                {t(lang, 'common.readMore')}
              </ArrowLink>
              <div class="mt-8 w-3/4 max-w-[360px] self-end lg:-mb-16 lg:mt-auto lg:w-full lg:self-start lg:translate-x-[-12%] lg:pt-8">
                {item.second ? (
                  <div class="aspect-[16/10] overflow-hidden shadow-[0_12px_32px_rgb(15_54_57/0.18)]">
                    <Img id={item.second} sizes="360px" maxWidth={360} aspect={1.6} class="h-full w-full" />
                  </div>
                ) : (
                  <GradientPanel class="aspect-[16/10] w-full" />
                )}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
