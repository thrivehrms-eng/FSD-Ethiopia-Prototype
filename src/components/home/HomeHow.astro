---
// 4.5 How we work: four tools, each with an icon in a 56px green circle.
import { Wrench, HandCoins, BarChart3, Megaphone } from '@lucide/astro';
import SectionTitle from '../ui/SectionTitle.astro';
import { t, langOf, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tools = [
  { id: 'ta', Icon: Wrench },
  { id: 'grants', Icon: HandCoins },
  { id: 'research', Icon: BarChart3 },
  { id: 'convening', Icon: Megaphone },
];
const k = (id: string, key: string) => `home.how.${id}.${key}`;
---

<section id="how" class="section bg-white" aria-labelledby="how-title">
  <div class="container-site">
    <SectionTitle lang={lang} k="home.how.title" id="how-title" />
    <p class="t-lead mt-5 max-w-2xl" lang="en">{t(lang, 'home.how.intro')}</p>
    <ul class="mt-12 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
      {
        tools.map(({ id, Icon }) => (
          <li data-reveal>
            <span class="flex size-14 items-center justify-center rounded-full bg-green-600 text-white" aria-hidden="true">
              <Icon size={26} stroke-width={1.75} />
            </span>
            <h3 class="t-label mt-5 text-[0.875rem] text-green-600" lang={langOf(lang, k(id, 'label'))}>{t(lang, k(id, 'label'))}</h3>
            <p class="mt-2 font-semibold leading-snug text-ink" lang="en">{t(lang, k(id, 'promise'))}</p>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-slate" lang="en">{t(lang, k(id, 'body'))}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
