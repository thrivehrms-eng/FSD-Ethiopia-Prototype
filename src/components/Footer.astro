---
import { Mail, Phone, MapPin, Clock } from '@lucide/astro';
import Logo from './Logo.astro';
import NewsletterForm from './NewsletterForm.astro';
import site from '../data/site.json';
import { t, langOf, localePath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
const headingClass = 'font-display text-[1.375rem] font-semibold text-white';
---

<footer class="on-dark bg-teal-900 text-white">
  <div class="brand-gradient h-1.5" aria-hidden="true"></div>
  <div class="container-site grid gap-12 py-14 lg:grid-cols-12 lg:gap-8 lg:py-20">
    <div class="lg:col-span-5">
      <Logo />
      <p class="mt-4 max-w-sm text-on-dark-muted" lang={langOf(lang, 'footer.tagline')}>{t(lang, 'footer.tagline')}</p>
      <div class="mt-10 max-w-md">
        <NewsletterForm lang={lang} />
      </div>
    </div>

    <div class="grid gap-10 sm:grid-cols-2 lg:col-span-7 lg:grid-cols-3">
      <section aria-labelledby="footer-contact">
        <h2 id="footer-contact" class={headingClass}>{t(lang, 'footer.contactTitle')}</h2>
        <address class="mt-4 space-y-3 text-[0.9375rem] not-italic text-on-dark-muted" lang="en">
          <p class="flex gap-3">
            <MapPin size={18} class="mt-1 shrink-0 text-yellow-400" aria-hidden="true" />
            <span>{t(lang, 'footer.address')}</span>
          </p>
          <p class="flex gap-3">
            <Mail size={18} class="mt-1 shrink-0 text-yellow-400" aria-hidden="true" />
            <a href={`mailto:${site.email}`} class="text-white hover:text-yellow-400">{site.email}</a>
          </p>
          <p class="flex gap-3">
            <Phone size={18} class="mt-1 shrink-0 text-yellow-400" aria-hidden="true" />
            <a href={`tel:${site.phoneHref}`} class="text-white hover:text-yellow-400">{site.phone}</a>
          </p>
          <p class="flex gap-3">
            <Clock size={18} class="mt-1 shrink-0 text-yellow-400" aria-hidden="true" />
            <span>{t(lang, 'footer.hours')}</span>
          </p>
        </address>

        <h2 class={`${headingClass} mt-10`}>{t(lang, 'footer.followTitle')}</h2>
        <ul class="mt-4 space-y-2 text-[0.9375rem]">
          {
            site.social.map((s) => (
              <li>
                {s.url ? (
                  <a href={s.url} class="text-white hover:text-yellow-400">{s.name}</a>
                ) : (
                  <span class="text-on-dark-muted">
                    {s.name} <span lang="en">({t(lang, 'footer.socialPending')})</span>
                  </span>
                )}
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="footer-network">
        <h2 id="footer-network" class={headingClass}>{t(lang, 'footer.networkTitle')}</h2>
        <ul class="mt-4 space-y-2 text-[0.9375rem]" lang="en">
          {
            site.network.map((n) => (
              <li>
                <a href={n.url} class="text-white hover:text-yellow-400">{n.name}</a>
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="footer-legal">
        <h2 id="footer-legal" class={headingClass}>{t(lang, 'footer.legalTitle')}</h2>
        <ul class="mt-4 space-y-2 text-[0.9375rem]">
          <li><a href={localePath(lang, '/privacy/')} class="text-white hover:text-yellow-400">{t(lang, 'footer.privacy')}</a></li>
          <li>
            <a href={localePath(lang, '/accessibility/')} class="text-white hover:text-yellow-400">{t(lang, 'footer.accessibility')}</a>
          </li>
          <li>
            <button
              type="button"
              class="cursor-pointer text-left text-white underline underline-offset-[0.2em] hover:text-yellow-400"
              data-open-cookie-prefs
            >
              {t(lang, 'footer.cookies')}
            </button>
          </li>
        </ul>
      </section>
    </div>
  </div>

  <div class="border-t border-white/15">
    <div class="container-site flex flex-col gap-2 py-6 text-sm text-on-dark-muted sm:flex-row sm:justify-between">
      <p>{t(lang, 'footer.copyright', { year })}</p>
      <p lang="en">{t(lang, 'footer.prototype')}</p>
    </div>
  </div>
</footer>
