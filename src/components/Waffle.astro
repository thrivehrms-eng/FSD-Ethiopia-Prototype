---
// 10 × 10 waffle chart. Decorative: the value is always stated in text beside it.
interface Props {
  value: number;
  tone: 'yellow' | 'white';
}

const { value, tone } = Astro.props;
const cells = Array.from({ length: 100 }, (_, i) => i < value);
---

<div class="waffle grid aspect-square w-full grid-cols-10 gap-[3px]" aria-hidden="true" data-tone={tone}>
  {cells.map((filled, i) => <span class:list={['waffle-cell', { filled }]} style={`--i:${i}`} />)}
</div>

<style>
  .waffle-cell {
    border-radius: 1px;
    background: rgb(255 255 255 / 0.12);
  }
  .waffle-cell.filled {
    animation: waffle-fill 240ms ease-out both;
    animation-delay: calc(var(--i) * 18ms + 200ms);
  }
  [data-tone='yellow'] .filled {
    --fill: var(--color-yellow-400);
  }
  [data-tone='white'] .filled {
    --fill: #ffffff;
  }
  @keyframes waffle-fill {
    from {
      background: rgb(255 255 255 / 0.12);
    }
    to {
      background: var(--fill);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .waffle-cell.filled {
      animation: none;
      background: var(--fill);
    }
  }
</style>
